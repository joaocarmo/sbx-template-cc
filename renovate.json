{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^claude-extended/claude-extended\\.yaml$/"
      ],
      "matchStrings": [
        "# syntax=(?<depName>docker/sandbox-kit):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
        "ref: (?<depName>docker\\.io/docker/sbx-kit-claude):(?<currentValue>\\S+)\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/publish\\.yml$/"
      ],
      "matchStrings": [
        "SBX_VERSION: (?<currentValue>v\\S+)\\s+SBX_DEB_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "docker/sbx-releases",
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates once CI is green (each merge to main publishes)",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    }
  ]
}
